# Яндекс.Метрика — ID счётчика. Инлайнится в клиентский бандл на этапе билда.
# Не задан → Метрика просто не подключается, билд и работа сайта не ломаются.
NEXT_PUBLIC_METRIKA_ID=

# n8n webhook для приёма заявок. Читается ТОЛЬКО на сервере (/api/lead), на клиент не утекает.
# Не задан → /api/lead отвечает 503 «Сервис временно недоступен», остальной сайт работает.
N8N_WEBHOOK_URL=

# Базовый URL сайта для sitemap/robots/canonical/JSON-LD. Инлайнится на этапе билда.
# Не задан → фолбэк https://pravobastion.ru (см. lib/site.ts), билд не падает.
NEXT_PUBLIC_SITE_URL=https://pravobastion.ru
