# Яндекс.Метрика — ID счётчика. Инлайнится в клиентский бандл на этапе билда.
# Не задан → Метрика просто не подключается, билд и работа сайта не ломаются.
NEXT_PUBLIC_METRIKA_ID=

# Webhook n8n для приёма заявок с формы-квалификатора. Читается ТОЛЬКО на сервере
# (/api/lead), на клиент не утекает. /api/lead шлёт туда POST { situation, phone, source, utm }
# с таймаутом 5 сек.
# Не задан ИЛИ n8n недоступен → клиент всё равно получает успех, а заявка пишется
# в fallback-лог с маркером LEAD_FALLBACK (stdout + файл), чтобы не потеряться.
N8N_WEBHOOK_URL=

# Куда складывать заявки, не дошедшие до n8n. Не задан → системный temp/lead-fallback.log.
# В Docker имеет смысл указать путь на примонтированном томе, иначе лог умрёт с контейнером.
LEAD_FALLBACK_FILE=

# Базовый URL сайта для sitemap/robots/canonical/JSON-LD. Инлайнится на этапе билда.
# Не задан → фолбэк https://mitragost.ru (см. lib/site.ts), билд не падает.
NEXT_PUBLIC_SITE_URL=https://mitragost.ru
