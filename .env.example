# Яндекс.Метрика — ID счётчика. Инлайнится в клиентский бандл на этапе билда.
# Не задан → Метрика просто не подключается, билд и работа сайта не ломаются.
NEXT_PUBLIC_METRIKA_ID=

# Telegram-бот: токен от @BotFather. Читается ТОЛЬКО на сервере, на клиент не
# утекает (нет префикса NEXT_PUBLIC_). В git не коммитить ни при каких условиях —
# утёкший токен даёт чужому доступ к переписке с клиентами.
TELEGRAM_BOT_TOKEN=

# Чат, куда падают заявки с формы и пересылки из бота. Для группы значение
# отрицательное, вида -1001234567890.
TELEGRAM_CHAT_ID=

# Секрет для проверки вебхука Telegram. Тем же значением регистрируется вебхук
# (параметр secret_token у setWebhook), роут /api/telegram/webhook сверяет его с
# заголовком X-Telegram-Bot-Api-Secret-Token. Не задан → роут принимает запросы
# без проверки, для прода так оставлять нельзя.
TELEGRAM_WEBHOOK_SECRET=

# Куда складывать заявки, не дошедшие до Telegram. Не задан → системный temp/lead-fallback.log.
# В Docker имеет смысл указать путь на примонтированном томе, иначе лог умрёт с контейнером.
LEAD_FALLBACK_FILE=

# Базовый URL сайта для sitemap/robots/canonical/JSON-LD. Инлайнится на этапе билда.
# Не задан → фолбэк https://mitragost.ru (см. lib/site.ts), билд не падает.
NEXT_PUBLIC_SITE_URL=https://mitragost.ru
